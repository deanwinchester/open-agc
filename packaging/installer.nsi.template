; Open-AGC Windows 安装包模板（NSIS 3, Unicode）
; 由 scripts/render_installer.py 渲染生成 dist/installer.nsi，
; 占位符：@APP_NAME@（ASCII 目录/文件名）@DISPLAY_NAME@（界面/快捷方式显示名，
; 支持中文）@VERSION@ @PAYLOAD_DIR@（PyInstaller 产物目录，固定 dist\Open-AGC）
Unicode true
!include "MUI2.nsh"

Name "@DISPLAY_NAME@"
OutFile "@OUT_ABS@\@DISPLAY_NAME@-@VERSION@-Setup.exe"
InstallDir "$PROGRAMFILES\@APP_NAME@"
RequestExecutionLevel admin

!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_LANGUAGE "SimpChinese"

Section "Install"

  ; ── 运行中检测：主程序在跑（用户可见的实例）→ 提示并自动关闭；
  ; 崩溃残留的 WebView2 僵尸子进程（无窗口但锁文件）→ 静默清理。
  ; 此前一刀切全报「正在运行」，僵尸进程也触发误报（生产实证）。
  ; 检测主程序（Open-AGC.exe，不含子进程）
  nsExec::ExecToStack 'powershell -NoProfile -Command "if (Get-Process -Name ''Open-AGC'' -ErrorAction SilentlyContinue | Where-Object { $$_.Path -like ''$INSTDIR\*'' }) { exit 1 } else { exit 0 }"'
  Pop $0
  ${If} $0 == 1
    MessageBox MB_ICONEXCLAMATION|MB_YESNO \
      "检测到 @DISPLAY_NAME@ 正在运行。$\n$\n点「是」自动关闭并继续安装，点「否」中止安装。" \
      /SD IDYES IDYES +2
      Abort
  ${EndIf}
  ; 静默清理安装目录下的所有相关进程（含旧实例崩溃残留的 WebView2 子进程），
  ; 等文件锁释放
  nsExec::ExecToLog 'powershell -NoProfile -Command "Get-Process | Where-Object { $$_.Path -like ''$INSTDIR\*'' } | Stop-Process -Force"'
  Sleep 2000

  SetOutPath "$INSTDIR"
  File /r "@PAYLOAD_DIR@\*.*"
  ; 桌面快捷方式（显示名，支持中文）
  CreateShortCut "$DESKTOP\@DISPLAY_NAME@.lnk" "$INSTDIR\@EXE_NAME@"
  ; 开始菜单：应用入口（打开方式）+ 卸载
  CreateDirectory "$SMPROGRAMS\@APP_NAME@"
  CreateShortCut "$SMPROGRAMS\@APP_NAME@\@DISPLAY_NAME@.lnk" "$INSTDIR\@EXE_NAME@"
  CreateShortCut "$SMPROGRAMS\@APP_NAME@\Uninstall.lnk" "$INSTDIR\uninstall.exe"
  WriteUninstaller "$INSTDIR\uninstall.exe"
SectionEnd

Section "Uninstall"
  RMDir /r "$INSTDIR"
  Delete "$DESKTOP\@DISPLAY_NAME@.lnk"
  RMDir /r "$SMPROGRAMS\@APP_NAME@"
SectionEnd
