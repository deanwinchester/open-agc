; Open-AGC Windows 安装包模板（NSIS 3, Unicode）
; 由 scripts/render_installer.py 渲染生成 dist/installer.nsi，
; 占位符：@APP_NAME@（ASCII 目录/文件名）@DISPLAY_NAME@（界面/快捷方式显示名，
; 支持中文）@VERSION@ @PAYLOAD_DIR@（PyInstaller 产物目录，固定 dist\Open-AGC）
Unicode true
!include "MUI2.nsh"

Name "@DISPLAY_NAME@"
OutFile "@OUT_ABS@\@DISPLAY_NAME@-@VERSION@-Setup.exe"
InstallDir "$PROGRAMFILES\@APP_NAME@"
RequestExecutionLevel admin
; 品牌定制：左下角文字与安装/卸载图标（替换 Nullsoft 默认）
BrandingText "@DISPLAY_NAME@"
Icon "@ICON_ABS@"
UninstallIcon "@ICON_ABS@"

!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_LANGUAGE "SimpChinese"

Section "Install"

  ; ── 运行中检测：主程序有【可见窗口】才提示（用户视角的「正在运行」）；
  ; 无窗口的后台残留（托盘驻留/崩溃残留的 WebView2 僵尸子进程）→ 静默清理。
  ; 此前只按进程名+路径判断：应用关窗驻留后台时进程还在，用户认为
  ; 「并未运行」却吃到提示（生产实证）。
  ; 检测有可见窗口的主程序（MainWindowHandle ≠ 0）
  nsExec::ExecToStack 'powershell -NoProfile -Command "if (Get-Process -Name ''Open-AGC'' -ErrorAction SilentlyContinue | Where-Object { $$_.Path -like ''$INSTDIR\*'' -and $$_.MainWindowHandle -ne 0 }) { exit 1 } else { exit 0 }"'
  Pop $0
  ${If} $0 == 1
    MessageBox MB_ICONEXCLAMATION|MB_YESNO \
      "检测到 @DISPLAY_NAME@ 正在运行。$\n$\n点「是」自动关闭并继续安装，点「否」中止安装。" \
      /SD IDYES IDYES +2
      Abort
  ${EndIf}
  ; 静默清理安装目录下的所有相关进程（含旧实例崩溃残留的 WebView2 子进程），
  ; 等文件锁释放
  nsExec::ExecToLog 'powershell -NoProfile -Command "Get-Process | Where-Object { $$_.Path -like ''$INSTDIR\*'' } | Stop-Process -Force"'
  Sleep 2000

  SetOutPath "$INSTDIR"
  File /r "@PAYLOAD_DIR@\*.*"
  ; 桌面快捷方式（显示名，支持中文）
  CreateShortCut "$DESKTOP\@DISPLAY_NAME@.lnk" "$INSTDIR\@EXE_NAME@"
  ; 开始菜单：应用入口（打开方式）+ 卸载
  CreateDirectory "$SMPROGRAMS\@APP_NAME@"
  CreateShortCut "$SMPROGRAMS\@APP_NAME@\@DISPLAY_NAME@.lnk" "$INSTDIR\@EXE_NAME@"
  CreateShortCut "$SMPROGRAMS\@APP_NAME@\Uninstall.lnk" "$INSTDIR\uninstall.exe"
  WriteUninstaller "$INSTDIR\uninstall.exe"
  ; 注册「设置-应用-安装的应用」卸载入口（此前只有开始菜单快捷方式，
  ; 系统卸载列表里找不到——生产实证）
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "DisplayName" "@DISPLAY_NAME@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "DisplayVersion" "@VERSION@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "Publisher" "@DISPLAY_NAME@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "DisplayIcon" "$INSTDIR\@EXE_NAME@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "NoModify" 1
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@" "NoRepair" 1
SectionEnd

Section "Uninstall"
  ; 卸载前结束运行中的实例（主程序/WebView2 子进程的文件锁会让 RMDir 失败）
  nsExec::ExecToLog 'powershell -NoProfile -Command "Get-Process | Where-Object { $$_.Path -like ''$INSTDIR\*'' } | Stop-Process -Force"'
  Sleep 1500
  RMDir /r "$INSTDIR"
  Delete "$DESKTOP\@DISPLAY_NAME@.lnk"
  RMDir /r "$SMPROGRAMS\@APP_NAME@"
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@APP_NAME@"
SectionEnd
