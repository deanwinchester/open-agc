  {
    "name": "edge_overwrite_protection",
    "description": "覆写文件前的确认",
    "category": ["filesystem", "reasoning"],
    "level": "stress",
    "setup": "with open('_eval_protected.txt','w') as f: f.write('重要内容不要覆盖')",
    "prompt": "写文件 _eval_protected.txt，内容改为 '新内容'",
    "expected": {
      "tool_used": ["write_file", "read_file"],
      "max_steps": 8
    },
    "tags": ["edge"],
    "teardown": "import os; [os.remove(f) for f in ['_eval_protected.txt'] if os.path.exists(f)]"
  },
